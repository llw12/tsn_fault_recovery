config cmdenv-express-mode false
config result-dir /home/opp_env/tsn_fault_recovery/experiments/exp02_joint_profile_activation/raw/dev_exp02/joint
config description "S1-S2 fails at 5ms; activate the precomputed joint {T1,P1} profile at 6ms"
config *.scenarioManager.script "xml(\"<scenario> <disconnect t='5ms' src-module='s1' dest-module='s2'/> </scenario>\")"
config *.profileSwitcher.enabled true
config *.profileSwitcher.switchTime 6ms
config *.profileSwitcher.activationSchedulingPriority -100
config *.profileSwitcher.profileId "\"manual-joint-T1-P1\""
config *.profileSwitcher.profileRouteSwitches "\"s1\""
config *.profileSwitcher.profileRouteInterfaces "\"eth2\""
config *.profileSwitcher.destinationPath "\"destination\""
config *.profileSwitcher.activateGclProfile true
config *.profileSwitcher.profileEgressInterfaces "\"s1.eth[2] s3.eth[1] s4.eth[2]\""
config *.profileSwitcher.cycleTime 1ms
config *.profileSwitcher.ttWindow 100us
config *.profileSwitcher.ttPacketBytes 200
config *.profileSwitcher.frameOverheadBytes 64
config *.profileSwitcher.linkBitrate 100Mbps
config *.profileSwitcher.ttTrafficClass 1
config *.profileSwitcher.beTrafficClass 0
config network tsn_fault_recovery.networks.DiamondTsnNetwork
config sim-time-limit 20ms
config *.*.eth[*].bitrate 100Mbps
config *.source.numApps 2
config *.source.app[*].typename UdpSourceApp
config *.source.app[0].display-name TT
config *.source.app[0].io.destAddress "\"destination\""
config *.source.app[0].io.destPort 1000
config *.source.app[0].source.packetLength 200B
config *.source.app[0].source.productionInterval 1ms
config *.source.app[1].display-name BE
config *.source.app[1].io.destAddress "\"destination\""
config *.source.app[1].io.destPort 1001
config *.source.app[1].source.packetLength 1400B
config *.source.app[1].source.productionInterval 200us
config *.source.app[0].io.displayStringTextFormat "\"{numSent} TT\""
config *.source.app[1].io.displayStringTextFormat "\"{numSent} BE\""
config *.destination.numApps 2
config *.destination.app[*].typename UdpSinkApp
config *.destination.app[0].display-name TT
config *.destination.app[0].io.localPort 1000
config *.destination.app[1].display-name BE
config *.destination.app[1].io.localPort 1001
config *.destination.app[0].io.displayStringTextFormat "\"{numReceived} TT\""
config *.destination.app[1].io.displayStringTextFormat "\"{numReceived} BE\""
config *.source.hasOutgoingStreams true
config *.source.bridging.streamIdentifier.identifier.mapping "[{stream: \"TT\", packetFilter: expr(udp.destPort == 1000)}, {stream: \"BE\", packetFilter: expr(udp.destPort == 1001)}]"
config *.source.bridging.streamCoder.encoder.mapping "[{stream: \"TT\", pcp: 4}, {stream: \"BE\", pcp: 0}]"
config *.s*.hasEgressTrafficShaping true
config *.s*.bridging.directionReverser.reverser.excludeEncapsulationProtocols "[\"ieee8021qctag\"]"
config *.s*.eth[*].macLayer.queue.numTrafficClasses 2
config *.s*.eth[*].macLayer.queue.*[0].display-name BE
config *.s*.eth[*].macLayer.queue.*[1].display-name TT
config *.s*.eth[*].macLayer.queue.transmissionGate[0].initiallyOpen false
config *.s*.eth[*].macLayer.queue.transmissionGate[0].durations "[100us, 900us]"
config *.s*.eth[*].macLayer.queue.transmissionGate[1].initiallyOpen true
config *.s*.eth[*].macLayer.queue.transmissionGate[1].durations "[100us, 900us]"
config *.visualizer.infoVisualizer.displayInfos true
config *.visualizer.infoVisualizer.placementHint "\"top\""
config *.visualizer.infoVisualizer.modules "\"*.*.app[*].io\""
config *.visualizer.networkNodeVisualizer.annotationSpacing 12
config *.visualizer.gateScheduleVisualizer.displayGateSchedules true
config *.visualizer.gateScheduleVisualizer.gateFilter "\"**.s1.eth[1].**\""
config *.visualizer.gateScheduleVisualizer.width 220
config *.visualizer.gateScheduleVisualizer.height 16
config *.visualizer.gateScheduleVisualizer.placementHint "\"top\""

