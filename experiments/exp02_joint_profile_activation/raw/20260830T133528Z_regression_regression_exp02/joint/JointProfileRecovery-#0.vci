config result-dir /home/opp_env/tsn_fault_recovery/experiments/exp02_joint_profile_activation/raw/20260830T133528Z_regression_regression_exp02/joint
config description "S1-S2 fails at 5ms; activate the precomputed joint {T1,P1} profile at 6ms"
config *.scenarioManager.script "xml(\"<scenario> <disconnect t='5ms' src-module='s1' dest-module='s2'/> </scenario>\")"
