config description "Fault-time BFS route computation plus deterministic route-derived GCL generation"
config *.scenarioManager.script "xml(\"<scenario> <disconnect t='5ms' src-module='s1' dest-module='s2'/> </scenario>\")"
config *.profileSwitcher.enabled false
config *.onlineJointRecoveryController.enabled true
