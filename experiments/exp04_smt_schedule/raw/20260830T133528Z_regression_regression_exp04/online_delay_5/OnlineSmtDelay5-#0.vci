config *.onlineJointRecoveryController.destination "\"destination\""
config *.onlineJointRecoveryController.cycleTime 1ms
config *.onlineJointRecoveryController.timeQuantum 1us
config *.onlineJointRecoveryController.ingressMargin 40us
config *.onlineJointRecoveryController.hopMargin 5us
config *.onlineJointRecoveryController.frameOverheadBytes 64
config *.onlineJointRecoveryController.linkBitrate 100Mbps
config *.onlineJointRecoveryController.ttTrafficClass 1
config *.onlineJointRecoveryController.beTrafficClass 0
config *.source.app[0].source.packetNameFormat "\"TT-%c\""
