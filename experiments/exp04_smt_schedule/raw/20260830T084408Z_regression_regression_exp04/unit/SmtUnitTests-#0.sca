attr datetimef 20260830-164424
attr experiment SmtUnitTests
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network tsn_fault_recovery.networks.SmtScheduleUnitTestNetwork
attr processid 596
attr repetition 0
attr replication #0
