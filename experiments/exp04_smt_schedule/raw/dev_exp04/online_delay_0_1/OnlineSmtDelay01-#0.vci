config *.packetIdentityRecorder.sourceModules "\"source.app[0].io\""
config *.packetIdentityRecorder.destinationModules "\"destination.app[0].io\""
config network tsn_fault_recovery.networks.DiamondTsnNetwork
config sim-time-limit 20ms
config *.*.eth[*].bitrate 100Mbps
