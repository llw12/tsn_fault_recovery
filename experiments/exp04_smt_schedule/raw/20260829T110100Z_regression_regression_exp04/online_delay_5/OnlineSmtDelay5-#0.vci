config *.destination.app[1].io.displayStringTextFormat "\"{numReceived} BE\""
config *.source.hasOutgoingStreams true
config *.source.bridging.streamIdentifier.identifier.mapping "[{stream: \"TT\", packetFilter: expr(udp.destPort == 1000)}, {stream: \"BE\", packetFilter: expr(udp.destPort == 1001)}]"
