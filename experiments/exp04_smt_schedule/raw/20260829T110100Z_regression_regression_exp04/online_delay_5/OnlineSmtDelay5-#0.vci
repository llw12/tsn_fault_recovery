config *.onlineJointRecoveryController.solverDelay 1ms
config *.onlineJointRecoveryController.failedEndpointA "\"s1\""
config *.onlineJointRecoveryController.failedEndpointB "\"s2\""
config *.onlineJointRecoveryController.routeStart "\"s1\""
config *.onlineJointRecoveryController.destination "\"destination\""
config *.onlineJointRecoveryController.cycleTime 1ms
config *.onlineJointRecoveryController.timeQuantum 1us
config *.onlineJointRecoveryController.ingressMargin 40us
config *.onlineJointRecoveryController.hopMargin 5us
config *.onlineJointRecoveryController.frameOverheadBytes 64
config *.onlineJointRecoveryController.linkBitrate 100Mbps
config *.onlineJointRecoveryController.ttTrafficClass 1
config *.onlineJointRecoveryController.beTrafficClass 0
config *.source.app[0].source.packetNameFormat "\"TT-%c\""
config *.source.app[0].source.packetRepresentation "\"applicationPacket\""
config *.packetIdentityRecorder.enabled true
config *.packetIdentityRecorder.flowIds "\"TT\""
config *.packetIdentityRecorder.sourceModules "\"source.app[0].io\""
config *.packetIdentityRecorder.destinationModules "\"destination.app[0].io\""
config network tsn_fault_recovery.networks.DiamondTsnNetwork
config sim-time-limit 20ms
config *.*.eth[*].bitrate 100Mbps
config *.source.numApps 2
config *.source.app[*].typename UdpSourceApp
config *.source.app[0].display-name TT
config *.source.app[0].io.destAddress "\"destination\""
config *.source.app[0].io.destPort 1000
config *.source.app[0].source.packetLength 200B
config *.source.app[0].source.productionInterval 1ms
config *.source.app[1].display-name BE
config *.source.app[1].io.destAddress "\"destination\""
config *.source.app[1].io.destPort 1001
config *.source.app[1].source.packetLength 1400B
config *.source.app[1].source.productionInterval 200us
config *.source.app[0].io.displayStringTextFormat "\"{numSent} TT\""
config *.source.app[1].io.displayStringTextFormat "\"{numSent} BE\""
