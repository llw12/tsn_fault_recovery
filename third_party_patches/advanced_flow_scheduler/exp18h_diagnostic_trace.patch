--- /dev/null
+++ b/include/solver/DiagnosticObserver.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstddef>
+#include <nlohmann/json.hpp>
+
+namespace diagnostic {
+
+// This interface is deliberately write-only: callers cannot obtain a value
+// that could influence a scheduling decision.
+class Observer
+{
+public:
+    virtual ~Observer() = default;
+    virtual auto emit(nlohmann::json event) noexcept -> void = 0;
+};
+
+struct PlacementTraceContext
+{
+    std::size_t attempt_index = 0;
+    std::size_t sub_cycle_index = 0;
+    std::size_t frame_index = 0;
+};
+
+} // namespace diagnostic

