@@ -0,0 +1,33 @@
+#pragma once
+
+#include "solver/DiagnosticObserver.h"
+#include <fstream>
+#include <memory>
+#include <string>
+
+namespace common {
+class NetworkUtilizationList;
+}
+
+namespace diagnostic {
+
+class JsonlTraceSink final : public Observer
+{
+public:
+    JsonlTraceSink(std::string path, std::string scenario);
+    ~JsonlTraceSink() override;
+
+    auto emit(nlohmann::json event) noexcept -> void override;
+    [[nodiscard]] auto healthy() const -> bool;
+
+private:
+    std::string path_;
+    std::string scenario_;
+    std::string run_id_;
+    std::unique_ptr<std::ofstream> stream_;
+    bool healthy_ = false;
+};
+
+[[nodiscard]] auto utilization_state(const common::NetworkUtilizationList& utilization) -> nlohmann::json;
+
+} // namespace diagnostic

