+
+diagnostic::JsonlTraceSink::JsonlTraceSink(std::string path, std::string scenario)
+    : path_(std::move(path)), scenario_(std::move(scenario)), run_id_(path_)
+{
+    stream_ = std::make_unique<std::ofstream>(path_, std::ios::out | std::ios::app);
+    healthy_ = static_cast<bool>(*stream_);
+    if(not healthy_) throw std::runtime_error("TRACE_IO_ERROR: unable to open diagnostic trace " + path_);
+}
+
+diagnostic::JsonlTraceSink::~JsonlTraceSink() = default;
+
+auto diagnostic::JsonlTraceSink::emit(nlohmann::json event) noexcept -> void
+{
+    if(not healthy_) return;
+    try {
+        event["schema_version"] = "exp18h-h2s-diagnostic-v1";
+        event["experiment"] = "exp18h_h2s_admission_placement_diagnostic_audit";
+        event["scenario"] = scenario_;
+        event["run_id"] = run_id_;
+        *stream_ << event.dump() << '\n';
+        stream_->flush();
+        healthy_ = static_cast<bool>(*stream_);
+    } catch(...) {
+        healthy_ = false;
+    }
+}
+
+auto diagnostic::JsonlTraceSink::healthy() const -> bool { return healthy_; }
+
+auto diagnostic::utilization_state(const common::NetworkUtilizationList& utilization) -> nlohmann::json
+{
+    nlohmann::json material = nlohmann::json::array();
+    std::size_t reservation_count = 0;
+    std::size_t total_reserved_ticks = 0;
+    const auto& reserved = utilization.getReservedEgressSlots();
+    const auto& free = utilization.getFreeEgressSlots();
+    for(std::size_t queue = 0; queue < reserved.size(); ++queue) {
+        nlohmann::json queue_state{{"queue_id", queue}, {"reserved", nlohmann::json::array()}, {"free", nlohmann::json::array()}};
+        for(const auto& item : reserved[queue]) {
+            queue_state["reserved"].push_back({item.start_time, item.next_slot_start, item.flow_id.get(), item.config_id.get()});
+            ++reservation_count; total_reserved_ticks += item.next_slot_start - item.start_time;
+        }
+        for(const auto& item : free[queue]) queue_state["free"].push_back({item.start_time, item.last_free_macro_tick});
+        material.push_back(std::move(queue_state));
+    }
+    const auto text = material.dump();
+    return {{"state_sha256", sha256(text)}, {"reservation_count", reservation_count}, {"total_reserved_ticks", total_reserved_ticks}};
+}

