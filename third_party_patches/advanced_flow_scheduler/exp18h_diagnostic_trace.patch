+{
+    for(std::size_t node = 0; node < getNumberOfNetworkNodes(); ++node) {
+        for(const auto& queue : getEgressQueuesOf(common::NetworkNodeID{node})) {
+            if(queue.id == queue_id) {
+                return common::NetworkNodeID{node};
+            }
+        }
+    }
+    throw std::out_of_range("Unknown egress queue");
